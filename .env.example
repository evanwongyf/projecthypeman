# Cloudflare R2 — the SAME credentials as the other apps on this account.
# Only R2_PROJECT_FOLDER differs, which is what keeps each app's data isolated.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=projects1
R2_PROJECT_FOLDER=projecthypeman

# Session signing secret (any long random string)
SESSION_SECRET=

# Used once by `npm run seed` to create the teacher login.
# Sign-in uses the email; the username stays the key for your data in R2.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
